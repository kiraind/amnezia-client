#ifndef VERSION_H
#define VERSION_H

#ifndef APP_VERSION
#define APP_VERSION "@CMAKE_PROJECT_VERSION@"
#endif

// Upstream base version plus the fork release, e.g. "5.0.3.1-lesha.1" (LESHA_FULL_VERSION)
#ifndef APP_FULL_VERSION
#define APP_FULL_VERSION "@LESHA_FULL_VERSION@"
#endif

#ifndef APP_MAJOR_VERSION
#define APP_MAJOR_VERSION "@APP_MAJOR_VERSION@"
#endif

#define APPLICATION_NAME        "@CLIENT_APPLICATION_NAME@"
// Network interface name for the WireGuard/AmneziaWG tunnel (Linux kernel iface,
// Windows Wintun adapter). Looks like an ordinary NIC rather than a VPN.
#define TUNNEL_INTERFACE_NAME   "@CLIENT_TUNNEL_INTERFACE_NAME@"
#define SERVICE_NAME            "@CLIENT_SERVICE_NAME@"
#define ORGANIZATION_NAME       "@CLIENT_ORGANIZATION_NAME@"
// User-visible application name (may be non-ASCII); emitted as UTF-8 byte escapes so it
// survives compilers that do not read sources as UTF-8 (MSVC without /utf-8)
#define DISPLAY_NAME            "@CLIENT_DISPLAY_NAME_CSTR@"

#endif  // VERSION_H
