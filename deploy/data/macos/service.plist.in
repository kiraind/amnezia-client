<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@CLIENT_SERVICE_NAME@</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/@CLIENT_APPLICATION_NAME@.app/Contents/MacOS/@CLIENT_SERVICE_NAME@</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>GroupName</key>
    <string>@AMN_SERVICE_GROUP@</string>
</dict>
</plist>
