<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
    <CPackWiXFragment Id="CM_CP_AmneziaVPN.@_AMNEZIA_WIX_SERVICE_FILE_ID@">
        <ServiceInstall
                Id="AmneziaServiceInstall"
                Name="@CLIENT_SERVICE_NAME@"
                DisplayName="@CLIENT_APPLICATION_NAME@ Service"
                Description="Service for @CLIENT_APPLICATION_NAME@"
                Start="auto"
                Type="ownProcess"
                ErrorControl="normal"
                Vital="no">
            <ServiceDependency Id="BFE" />
            <ServiceDependency Id="nsi" />
        </ServiceInstall>
        <ServiceControl
                Id="AmneziaServiceControl"
                Name="@CLIENT_SERVICE_NAME@"
                Start="install"
                Stop="both"
                Remove="uninstall"
                Wait="yes" />
    </CPackWiXFragment>
</CPackWiXPatch>
